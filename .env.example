# Copy to .env only for manual setup. scripts/bootstrap.ps1 generates strong local values.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO

POSTGRES_DB=localguard
POSTGRES_USER=localguard
POSTGRES_PASSWORD=generate-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://localguard:generate-a-long-random-local-password@db:5432/localguard
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
OUTBOX_POLL_SECONDS=2
OUTBOX_CLAIM_TTL_SECONDS=60
OUTBOX_DELIVERY_TIMEOUT_SECONDS=900
CLEANUP_POLL_SECONDS=5

UPLOAD_ROOT=/var/lib/localguard/uploads
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_DOCX_PARAGRAPHS=2500
MAX_TEXT_LINES=5000
MAX_EXTRACTED_CHARACTERS=500000
MAX_DOCX_ENTRIES=2500
MAX_DOCX_EXPANDED_BYTES=52428800
MAX_DOCX_COMPRESSION_RATIO=100

SESSION_COOKIE_NAME=localguard_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=60
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_COOKIE_NAME=localguard_csrf
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
BOOTSTRAP_ADMIN_PASSWORD=generated-by-bootstrap
BOOTSTRAP_REVIEWER_PASSWORD=generated-by-bootstrap
BOOTSTRAP_VIEWER_PASSWORD=generated-by-bootstrap

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b-q4_K_M
OLLAMA_EMBED_MODEL=all-minilm:22m-l6-v2-fp16
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
MODEL_CONTEXT_TOKENS=4096
MODEL_MAX_OUTPUT_TOKENS=512
MODEL_LOCK_TTL_SECONDS=300
MODEL_HTTP_TIMEOUT_SECONDS=180
RETRIEVAL_LIMIT=8
RETRIEVAL_CANDIDATE_LIMIT=24
RETRIEVAL_MIN_SCORE=0.012
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.35
RETRIEVAL_MIN_TEXT_SCORE=0.05
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
ALLOW_TEST_PROVIDERS=false

PROPOSAL_TTL_MINUTES=1440
MCP_BIND_HOST=0.0.0.0
MCP_PORT=8001
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_BOOTSTRAP_TOKEN=generated-by-bootstrap
MCP_BOOTSTRAP_TOKEN_TTL_DAYS=30
