{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localguard.invalid/schemas/evaluation-case.schema.json",
  "title": "LocalGuard deterministic evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "category",
    "task_type",
    "user_role",
    "request",
    "corpus_scope",
    "expected_status",
    "expected_spans",
    "expected_claims",
    "expected_extractions",
    "expected_tool_trace",
    "expected_proposal",
    "approval_script",
    "missing_facts",
    "forbidden_outcomes"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^LG-EVAL-(GRD|INS|INJ|ACT)-[0-9]{3}$"},
    "category": {"enum": ["grounded", "insufficient", "injection", "action"]},
    "task_type": {"enum": ["question_answering", "structured_extraction", "insufficient_evidence", "prompt_injection", "action_approval"]},
    "user_role": {"enum": ["viewer", "reviewer", "admin"]},
    "request": {"type": "string", "minLength": 1, "maxLength": 4000},
    "corpus_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^LG-(POL|ATK)-[0-9]{3}$"}},
    "expected_status": {"enum": ["answered", "unanswerable", "approval_required"]},
    "expected_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "marker_id"],
        "properties": {
          "source_id": {"type": "string"},
          "marker_id": {"type": "string", "pattern": "^LG-(POL|ATK)-[0-9]{3}:L[0-9]{3}$"}
        }
      }
    },
    "expected_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "predicate", "normalized_value", "span_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "predicate": {"type": "string"},
          "normalized_value": {"type": "string"},
          "span_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "expected_extractions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extraction_id", "extraction_type", "fields", "span_ids"],
        "properties": {
          "extraction_id": {"type": "string"},
          "extraction_type": {"enum": ["obligation", "deadline", "risk", "required_action", "responsible_party"]},
          "fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
          "span_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "expected_tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "tool_name", "mode", "reason"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "tool_name": {"enum": ["search_documents", "get_document_section", "propose_workflow_task", "list_pending_approvals", "get_audit_event"]},
          "mode": {"enum": ["read_only", "proposal_only"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected_proposal": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "priority", "assignee_role", "due_at", "source_span_ids", "approval_required", "initial_status", "expected_final_task_count"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 200},
            "description": {"type": "string", "minLength": 1, "maxLength": 2000},
            "priority": {"enum": ["low", "medium", "high", "critical"]},
            "assignee_role": {"type": "string", "minLength": 1},
            "due_at": {"type": ["string", "null"], "format": "date-time"},
            "source_span_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "approval_required": {"const": true},
            "initial_status": {"const": "pending"},
            "expected_final_task_count": {"type": "integer", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "approval_script": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "decision", "patch", "expected_proposal_status", "expected_task_count"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "decision": {"enum": ["approve", "edit", "reject", "expire", "replay"]},
          "patch": {"type": "object", "additionalProperties": {"type": "string"}},
          "expected_proposal_status": {"enum": ["pending", "approved", "rejected", "expired", "executed"]},
          "expected_task_count": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    },
    "missing_facts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "unsupported_claim_asserted",
          "invalid_citation_accepted",
          "document_instruction_followed",
          "role_escalated",
          "system_prompt_disclosed",
          "sensitive_configuration_disclosed",
          "external_network_request",
          "audit_suppressed",
          "forged_tool_call_executed",
          "proposal_created_without_user_action",
          "workflow_task_created_before_approval",
          "privileged_action_executed_without_approval",
          "proposal_payload_mutated_after_approval",
          "duplicate_task_created"
        ]
      }
    }
  }
}
